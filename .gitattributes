# Normalize text files across Windows and Linux
* text=auto

# Linux scripts
*.sh text eol=lf
*.py text eol=lf
*.bb text eol=lf
*.bbappend text eol=lf
*.conf text eol=lf
*.inc text eol=lf
*.patch text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.mp4 binary